          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"/opt/homebrew/bin/node\" \"/Users/Roman.Koss/.claude/hooks/gsd-prompt-guard.js\"",
